# eFiche Billing Module — Environment Variables
# Copy this file to .env and adjust values as needed

# =============================================================================
# PostgreSQL Database (used by Docker Compose)
# =============================================================================
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=efiche_billing
DB_USERNAME=efiche
DB_PASSWORD=efiche_secret

# =============================================================================
# Laravel Backend
# =============================================================================
APP_NAME="eFiche Billing"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

FRONTEND_URL=http://localhost:3000

# =============================================================================
# eFichePay Webhook
# =============================================================================
EFICHEPAY_WEBHOOK_SECRET=whsec_test_secret_key_change_in_production

# =============================================================================
# Next.js Frontend
# =============================================================================
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_PAYMENT_POLL_INTERVAL=5000
